# Copy to .env and fill in to use a real LLM judge.
# If LLM_API_KEY is empty, the app falls back to the offline HeuristicJudge,
# so the demo, CLI, and tests all run without any key.

# Any OpenAI-compatible provider (OpenAI, Polza.ai, local Ollama, etc.)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
